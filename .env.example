# Local dev only. No GxP secrets exist at this stage of the project.
# Copy this file to .env and replace POSTGRES_PASSWORD with a locally generated value.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace_me_local_dev_only
POSTGRES_DB=sentinel

# Phase 3 (D-01): multi-provider LLM router credentials. These four keys
# are required only for LIVE LLM calls (Gemini/DeepSeek/Groq/OpenRouter).
# Without them, app.llm_router.call_llm() runs in an explicit degraded/
# abstain mode (LLMResponse.degraded=True) instead of raising - see
# backend/app/llm_router.py and 03-CONTEXT.md's credential-gap resolution.
# Never write a real or guessed key value into this file.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Phase 3: asyncpg connection string for app.db.get_pool(). The password
# segment must match POSTGRES_PASSWORD above in your own .env.
DATABASE_URL=postgresql://sentinel:changeme@127.0.0.1:5432/sentinel
